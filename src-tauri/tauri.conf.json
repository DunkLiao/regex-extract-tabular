{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Regex Extract & Tabular",
  "version": "1.0.0",
  "identifier": "com.regexextract.tabular",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Regex Extract & Tabular",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src 'none'; worker-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
